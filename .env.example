# Copy this file to ".env.local" and fill in the real values.

# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://dtsgroupe.com

# Web3Forms access key — get a free key at https://web3forms.com
# (link it to dtsgroupesarl@gmail.com). Without it, the contact form falls
# back to the WhatsApp button.
NEXT_PUBLIC_WEB3FORMS_KEY=

# Analytics (optional) — the scripts only load when an ID is present.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
